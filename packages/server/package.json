{
  "private": true,
  "type": "module",
  "author": "Костя Третяк <ktretiak.in.ua@gmail.com>",
  "name": "server",
  "description": "Holu application",
  "version": "1.0.0",
  "main": "dist/index",
  "types": "dist/index",
  "directories": {
    "lib": "src"
  },
  "scripts": {
    "start": "npm run build && node --watch --env-file=.env --enable-source-maps dist/main.js",
    "start-prod": "npm run build && node --env-file=.env dist/main.js",
    "test": "npm run build-test && node --env-file=.env --enable-source-maps ../../node_modules/.bin/vitest",
    "build-test": "tsc -b tsconfig.test.json",
    "build": "tsc -b tsconfig.build.json",
    "watch": "npm run build -- --watch",
    "start:dev": "holu start src/main.ts",
    "clean": "rimraf dist*"
  },
  "imports": {
    "#services-per-app/*": "./dist/app/services-per-app/*",
    "#app/*": "./dist/app/*",
    "#configs/*": "./dist/app/configs/*",
    "#classes/*": "./dist/app/classes/*",
    "#service/*": "./dist/app/modules/service/*",
    "#routed/*": "./dist/app/modules/routed/*",
    "#dto/*": "./dist/app/dto/*",
    "#entities": "./dist/app/entities/index.js",
    "#utils/*": "./dist/app/utils/*",
    "#shared": "shared"
  },
  "dependencies": {
    "@holu/authjs": "^0.1.2",
    "@holu/body-parser": "^0.1.2",
    "@holu/core": "^0.1.2",
    "@holu/cors": "^0.1.2",
    "@holu/i18n": "^0.1.2",
    "@holu/jwt": "^0.1.2",
    "@holu/openapi": "^0.1.2",
    "@holu/openapi-validation": "^0.1.2",
    "@holu/rest": "^0.1.2",
    "@holu/typeorm": "^0.1.2",
    "@ts-stack/chain-error": "^1.5.1",
    "@ts-stack/cookies": "^1.2.2",
    "@ts-stack/openapi-spec": "^3.1.6",
    "bunyan": "^1.8.15",
    "mysql2": "^3.23.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@holu/rest-testing": "^0.1.2",
    "@types/bunyan": "^1.8.11",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">= 24.0.0"
  }
}
